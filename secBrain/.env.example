PORT=3001
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
JWT_PASSWORD=your_jwt_secret_key_here
LOG_LEVEL=info

# Optional AI Embedding Provider keys (Google Gemini or OpenAI)
# If omitted, a local deterministic 768-dim adapter is used automatically.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
